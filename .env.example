# Copie para .env apenas quando não utilizar os scripts dev-up.
# Gere senhas aleatórias e independentes; não reutilize credenciais reais.
POSTGRES_DB=meufinanceiro
POSTGRES_USER=meufinanceiro_admin
POSTGRES_PASSWORD=replace-with-a-random-admin-password
APP_DATABASE_USER=meufinanceiro_app
APP_DATABASE_PASSWORD=replace-with-a-different-random-app-password
APP_HTTP_PORT=8080

# Flutter é o runtime Web padrão. Use react-runtime somente como rollback transitório.
WEB_RUNTIME_TARGET=flutter-runtime

# O arquivo é gerado localmente e nunca deve ser versionado.
APP_KEYRING_FILE_HOST=.secrets/keyring.json
